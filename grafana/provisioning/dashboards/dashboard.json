{
  "id": null,
  "title": "ESP32 Sensor Dashboard",
  "tags": [
    "esp32",
    "sensors"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "panels": [
    {
      "type": "timeseries",
      "title": "Temperature (°C)",
      "datasource": {
        "type": "postgres",
        "uid": "Sensors"
      },
      "targets": [
        {
          "format": "time_series",
          "rawSql": "SELECT ts AS time, device_id, temp_c FROM measurements WHERE $__timeFilter(ts) ORDER BY ts",
          "refId": "A"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT ts AS time, temp_c AS value, device_id || ' z-score' AS metric FROM measurements WHERE $__timeFilter(ts) AND temp_zscore_anomaly IS TRUE ORDER BY ts",
          "refId": "B"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT ts AS time, temp_c AS value, device_id || ' ewma' AS metric FROM measurements WHERE $__timeFilter(ts) AND temp_ewma_anomaly IS TRUE ORDER BY ts",
          "refId": "C"
        },
        {
          "format": "time_series",
          "rawSql": "SELECT ts AS time, temp_c AS value, device_id || ' adaptive threshold' AS metric FROM measurements WHERE $__timeFilter(ts) AND temp_adaptive_threshold_anomaly IS TRUE ORDER BY ts",
          "refId": "D"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius"
        },
        "overrides": [
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "B"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 8
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.pointStyle",
                "value": "crossRot"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "C"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 8
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.pointStyle",
                "value": "circle"
              }
            ]
          },
          {
            "matcher": {
              "id": "byFrameRefID",
              "options": "D"
            },
            "properties": [
              {
                "id": "custom.drawStyle",
                "value": "points"
              },
              {
                "id": "custom.showPoints",
                "value": "always"
              },
              {
                "id": "custom.pointSize",
                "value": 8
              },
              {
                "id": "custom.lineWidth",
                "value": 0
              },
              {
                "id": "custom.pointStyle",
                "value": "square"
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      }
    },
